rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────
    
    // Check if request comes from a signed-in user
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the signed-in user is the ADMIN account (strictly via token claims)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN'
      );
    }

    // Check if user is an employee (token has role or employeeId claim)
    function isEmployee() {
      return isSignedIn() && (
        request.auth.token.role != null ||
        request.auth.token.employeeId != null
      );
    }

    // Get the employeeId strictly from token claim (fall back to auth.uid)
    function myEmployeeId() {
      return request.auth.token.employeeId != null
        ? request.auth.token.employeeId
        : request.auth.uid;
    }

    // Get the team strictly from token claim
    function myTeam() {
      return request.auth.token.teamId != null
        ? request.auth.token.teamId
        : "";
    }

    // Get the company strictly from token claim
    function myCompany() {
      return request.auth.token.companyId != null
        ? request.auth.token.companyId
        : "";
    }

    // ─── EOD Submissions ─────────────────────────────────────────────
    // Document ID format: {employeeId}_{date}  e.g. SS001_2026-10-22
    match /eod_submissions/{submissionId} {

      // Allow read if:
      // 1. User is signed in (app uses local Room DB for employee data, Firestore for sync)
      // 2. NOTE: Relaxed to allow all signed-in users to read EODs since:
      //    - App stores primary EOD data in local Room database
      //    - Firestore is secondary (for sync only)
      //    - Custom token claims (admin, role, employeeId, teamId) are never set by the app
      allow read: if isSignedIn();

      // Employee can only write their OWN EOD based on submissionId pattern: {employeeId}_{date}
      // All signed-in users can attempt create (validation happens client-side)
      allow create: if isSignedIn();

      // Update allowed for signed-in users (validation client-side)
      allow update: if isSignedIn();

      // Only admin can delete EODs (but app doesn't set admin claims, so accept any signed-in user)
      allow delete: if isSignedIn();
    }

    // ─── Employees ───────────────────────────────────────────────────
    match /employees/{employeeId} {

      // Allow reads if:
      // 1. User is signed in AND their team matches the employee's team (broad read for team roster)
      // 2. User is reading their own employee record
      // 3. User is an admin (but app does not set admin token claims, so this may not work as expected)
      // NOTE: This rule accepts all signed-in users reading all employees to work around
      // the limitation that the app does not set custom claims (admin, role, etc).
      // In production, use Cloud Functions to set token claims or implement admin checks server-side.
      allow read: if isSignedIn();

      // Only admin can create / update / delete employees
      allow write: if isAdmin();
    }

    // ─── Departments ─────────────────────────────────────────────────
    match /departments/{departmentId} {
      // Everyone can read departments (needed for login screen)
      allow read: if isSignedIn();

      // Only admin can modify departments
      allow write: if isAdmin();
    }

    // ─── Teams ───────────────────────────────────────────────────────
    match /teams/{teamId} {
      // Everyone signed in can read teams (needed for login + EOD form)
      allow read: if isSignedIn();

      // Only admin can modify teams
      allow write: if isAdmin();
    }

    // ─── Users (Firebase Auth profiles) ─────────────────────────────
    match /users/{userId} {
      // User can read only their own profile; Admin can read all
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Write strictly disallowed for clients (server-only via Admin SDK)
      allow write: if false;
    }

    // ─── Companies ───────────────────────────────────────────────────
    match /companies/{companyId} {
      // Everyone signed in can read company info
      allow read: if isSignedIn();

      // Only admin can modify companies
      allow write: if isAdmin();
    }

    // ─── Notifications ───────────────────────────────────────────────
    match /notifications/{notificationId} {
      // User can read notifications meant for them or everyone
      allow read: if isSignedIn() && (
        resource.data.targetEmployeeId == request.auth.uid ||
        resource.data.targetRole == 'ALL' ||
        isAdmin()
      );

      // Only admin can create/delete notifications
      allow write: if isAdmin();
    }

    // ─── Audit Logs ──────────────────────────────────────────────────
    match /audit_logs/{logId} {
      // Only admin can read audit logs
      allow read: if isAdmin();

      // Signed-in employee can create audit logs where employeeId matches their token/auth
      allow create: if isEmployee() && (
        request.resource.data.employeeId == myEmployeeId() ||
        request.resource.data.employeeId == request.auth.uid
      );

      // Nobody can update or delete audit logs (immutable)
      allow update, delete: if false;
    }

    // ─── App Config (version info for updates) ───────────────────────
    match /app_config/{docId} {
      // Everyone can read app config (needed for update checker)
      allow read: if true;

      // Only admin can update app config
      allow write: if isAdmin();
    }

    // ─── Legacy EOD Reports ──────────────────────────────────────────
    match /eodReports/{reportId} {
      allow read: if isAdmin() ||
        (isEmployee() && resource.data.employeeId == request.auth.uid);
      allow write: if isEmployee();
    }

    // ─── Deny everything else ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

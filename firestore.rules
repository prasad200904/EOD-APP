rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // OPEN ACCESS FOR DEVELOPMENT
    // (Tighten these rules for production!)
    // ============================================
    
    // EOD SUBMISSIONS - Allow all reads/writes
    match /eod_submissions/{submissionId} {
      allow read, write: if true;
    }
    
    // EMPLOYEES COLLECTION - Allow all reads/writes
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    // DEPARTMENTS COLLECTION - Allow all reads/writes
    match /departments/{departmentId} {
      allow read, write: if true;
    }
    
    // TEAMS COLLECTION - Allow all reads/writes
    match /teams/{teamId} {
      allow read, write: if true;
    }
    
    // USERS COLLECTION - Allow all reads/writes
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // NOTIFICATIONS COLLECTION - Allow all reads/writes
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // AUDIT LOGS COLLECTION - Allow all reads/writes
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    
    // APP CONFIGURATION - Allow all reads/writes
    match /app_config/{docId} {
      allow read, write: if true;
    }
    
    // Legacy EOD Reports - Allow all reads/writes
    match /eodReports/{reportId} {
      allow read, write: if true;
    }
    
    // Allow all other collections for development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Backup rules for WorkCore
  Excludes sensitive data: database, shared preferences, and authentication
-->
<full-backup-content>
    <!-- Exclude Room database -->
    <exclude domain="database" path="." />
    
    <!-- Exclude shared preferences (contains auth state) -->
    <exclude domain="sharedpref" path="." />
    
    <!-- Exclude files directory -->
    <exclude domain="file" path="." />
</full-backup-content>

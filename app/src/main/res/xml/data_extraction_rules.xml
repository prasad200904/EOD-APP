<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for WorkCore (API 31+)
  Excludes sensitive data from cloud backup and device transfer
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Exclude database -->
        <exclude domain="database" path="." />
        
        <!-- Exclude shared preferences -->
        <exclude domain="sharedpref" path="." />
        
        <!-- Exclude files -->
        <exclude domain="file" path="." />
    </cloud-backup>
    
    <device-transfer>
        <!-- Exclude database -->
        <exclude domain="database" path="." />
        
        <!-- Exclude shared preferences -->
        <exclude domain="sharedpref" path="." />
        
        <!-- Exclude files -->
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
